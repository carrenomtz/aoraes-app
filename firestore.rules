// Reglas de Firestore del proyecto "aoraes-crm". Al hacer push a main con cambios en este
// archivo, .github/workflows/deploy-firestore-rules.yml las despliega solo — ya no hace falta
// pegarlas a mano en Firebase Console. Si alguna vez se edita directamente en la consola por
// urgencia, hay que traer ese cambio aquí también (con un commit) para que no se desincronicen.
// FIREBASE_TOKEN (secreto de Actions) se rotó por última vez el 18 sept. 2026.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Respaldo de emergencia: si por lo que sea el perfil de /users/{uid} no existiera o no dijera
    // role:'admin' (p. ej. una cuenta nueva antes de que ensureProfileAndListen la repare sola), esta
    // ruta igual reconoce al admin principal sin depender de ese documento. Identificado por UID, no
    // por correo — el mismo criterio que ya usa el código cliente (ADMIN_UID en index.html), para que
    // cambiar de correo algún día nunca deje sin este respaldo. Antes comparaba
    // request.auth.token.email == 'carlos.carreno@dvag.de', que se habría roto justo en ese caso.
    function isPrimaryAdmin() {
      return isSignedIn() && request.auth.uid == 'DMDXyvqfaeQiXfb3pYmoX95vNR82';
    }

    function isAdmin() {
      return isPrimaryAdmin()
        || (isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'admin'
          && userDoc().data.status == 'approved');
    }

    function isAdvisor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'advisor'
        && userDoc().data.status == 'approved';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMoney(value) {
      return value is number && value >= 0 && value <= 10000000;
    }

    // Acceso a los datos de un asesor (sus clientes y sus contactos): el propio asesor aprobado o el admin.
    // Es EXACTAMENTE la condición que ya tenían las reglas de /clients y /leads; solo se ha sacado a una función.
    function canAccessAdvisorData(uid) {
      return isSignedIn() && (
        (request.auth.uid == uid
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.status == 'approved')
        || isAdmin()
      );
    }

    // Forma y tamaño del documento de un cliente. La app (syncClient en index.html) siempre lo guarda con setDoc completo:
    //   { id, record, solution, medico, exportedAt }   (solution y medico pueden ser null)
    // Es deliberadamente tolerante: no exige "solo estas claves" para no romper la importación de copias antiguas, pero acota
    // el tipo de cada campo conocido y el número de claves. Los límites son muy superiores a lo observado (record: 16 claves,
    // 2-8 KB; Firestore ya limita el documento entero a 1 MiB).
    function validClientDoc(clientId) {
      let d = request.resource.data;
      return d.keys().size() <= 12
        && d.id is string
        && d.id == clientId
        && d.record is map
        && d.record.keys().size() <= 80
        && (!('name' in d.record) || (d.record.name is string && d.record.name.size() <= 300))
        && (!('solution' in d) || d.solution == null || d.solution is map)
        && (!('medico' in d) || d.medico == null || d.medico is map)
        && (!('exportedAt' in d) || (d.exportedAt is string && d.exportedAt.size() <= 40));
    }

    // Forma y tamaño de un contacto (users/{uid}/leads/{leadId}). Campos que escribe la app: name, email, phone, notes, status,
    // importedAt, leadNo y lastContactAt (texto o serverTimestamp); la tabla también permite corregir cualquier campo suelto a mano,
    // por eso solo se validan los conocidos y se pone un tope de claves. Campos de la ficha del contacto (todos opcionales, así que los
    // documentos anteriores siguen siendo válidos): nextAction/nextActionAt (siguiente acción y su día YYYY-MM-DD), source (origen),
    // doNotContact/dncReason/dncAt (marca de no contactar, con motivo y fecha) e history (lista de eventos {at, by, type, ...}).
    // La bolsa (/leadsPool) es solo del admin y no pasa por esta función.
    function validLeadDoc() {
      let d = request.resource.data;
      return d.keys().size() <= 40
        && (!('name' in d) || (d.name is string && d.name.size() <= 300))
        && (!('email' in d) || (d.email is string && d.email.size() <= 300))
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 100))
        && (!('leadNo' in d) || (d.leadNo is string && d.leadNo.size() <= 200))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 20000))
        && (!('status' in d) || (d.status is string && d.status.size() <= 60))
        && (!('importedAt' in d) || (d.importedAt is string && d.importedAt.size() <= 60))
        && (!('lastContactAt' in d) || (d.lastContactAt is timestamp) || (d.lastContactAt is string && d.lastContactAt.size() <= 60))
        && (!('nextAction' in d) || (d.nextAction is string && d.nextAction.size() <= 200))
        && (!('nextActionAt' in d) || (d.nextActionAt is string && d.nextActionAt.size() <= 30))
        && (!('source' in d) || (d.source is string && d.source.size() <= 200))
        && (!('doNotContact' in d) || d.doNotContact is bool)
        && (!('dncReason' in d) || (d.dncReason is string && d.dncReason.size() <= 300))
        && (!('dncAt' in d) || (d.dncAt is string && d.dncAt.size() <= 60))
        && (!('history' in d) || (d.history is list && d.history.size() <= 1000));
    }

    function hasNewTimestamps() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function preservesCreatedAt() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'fullName', 'phone', 'profession', 'source', 'role', 'status', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5
        && request.resource.data.phone.size() <= 40
        && request.resource.data.profession is string
        && request.resource.data.profession.size() >= 2
        && request.resource.data.profession.size() <= 100
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 200
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.role == 'client' && request.resource.data.status == 'active')
          || (request.resource.data.role == 'advisor' && request.resource.data.status == 'pending')
          // Primer alta del admin principal (el código cliente la escribe como admin/approved); solo por UID.
          || (isPrimaryAdmin() && request.resource.data.role == 'admin' && request.resource.data.status == 'approved')
        );

      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt'])
          && request.resource.data.lastLoginAt == request.time)
        || (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName'])
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() >= 2
          && request.resource.data.fullName.size() <= 100)
        || (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'profession', 'source'])
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() >= 2
          && request.resource.data.fullName.size() <= 100
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 5
          && request.resource.data.phone.size() <= 40
          && request.resource.data.profession is string
          && request.resource.data.profession.size() >= 2
          && request.resource.data.profession.size() <= 100
          && request.resource.data.source is string
          && request.resource.data.source.size() <= 200);
      // Borrar la cuenta de un asesor desde el panel (deleteAdvisorAccount) acaba con deleteDoc(users/{uid}); antes
      // esta regla era `if false` y el borrado fallaba a medias. Solo el admin, nunca su propio perfil ni el del admin
      // principal. El progreso de Estudio NO se puede borrar desde aquí (decisión ya probada: el admin no borra el de otro).
      allow delete: if isAdmin()
        && request.auth.uid != uid
        && uid != 'DMDXyvqfaeQiXfb3pYmoX95vNR82';

      match /savedArticles/{articleId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['articleId', 'slug', 'savedAt'])
          && request.resource.data.articleId == articleId
          && request.resource.data.slug is string
          && request.resource.data.slug.size() >= 1
          && request.resource.data.slug.size() <= 120
          && request.resource.data.savedAt == request.time
          && exists(/databases/$(database)/documents/articles/$(articleId))
          && get(/databases/$(database)/documents/articles/$(articleId)).data.status == 'published';
        allow update: if false;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /clients/{clientId} {
        allow read: if canAccessAdvisorData(uid);
        allow create, update: if canAccessAdvisorData(uid) && validClientDoc(clientId);
        allow delete: if canAccessAdvisorData(uid);
      }

      // Progreso de estudio de la pestaña "Estudio" del panel (app React en /estudio/, un único documento
      // "main" por usuario: temas, flashcards, intentos de examen…). Solo el propio asesor (o el admin, en su
      // propia cuenta) lo lee y escribe; el admin además puede LEER el de cualquiera (panel Equipo de Estudio,
      // solo lectura). Los clientes de la web (rol 'client') y las cuentas pendientes no tienen acceso.
      match /progress/{docId} {
        allow read: if (isOwner(uid) && (isAdvisor() || isAdmin())) || isAdmin();
        allow create, update: if isOwner(uid) && (isAdvisor() || isAdmin())
          && docId == 'main'
          // Forma real que escribe Estudio (ProgressContext): { state, updatedAt }. Los límites de tamaño dentro de
          // `state` no se pueden expresar en reglas; los acota el cliente (histórico de intentos) y Firestore (1 MiB).
          && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
          && request.resource.data.state is map
          && request.resource.data.updatedAt is number;
        allow delete: if isOwner(uid) && (isAdvisor() || isAdmin()) && docId == 'main';
      }

      // Bolsa fría por asesor (contactos importados de Excel, todavía sin análisis): mismo criterio
      // que /clients — cada asesor solo ve/edita la suya, el admin ve/edita cualquiera (necesario
      // para "Importar Excel" y la asignación en bloque, que escriben en la subcolección del asesor
      // que el admin elija, no en la suya propia).
      match /leads/{leadId} {
        allow read: if canAccessAdvisorData(uid);
        allow create, update: if canAccessAdvisorData(uid) && validLeadDoc();
        allow delete: if canAccessAdvisorData(uid);
      }
    }

    // Firestore deniega una consulta collectionGroup entera si la regla de la ruta coincidente
    // compara contra el wildcard del path en CUALQUIER rama de su condición — aunque esa rama no sea
    // la que concede el acceso. Las reglas de /users/{uid}/clients y /users/{uid}/leads, arriba,
    // comparan request.auth.uid == uid (para que cada asesor vea la suya), así que
    // collectionGroup(db,'clients')/'leads' le devolvía permission-denied incluso al admin
    // (confirmado en vivo: listAllLeadsAcrossAdvisors y la campana de "clientes recientes" del admin
    // fallaban con ese código pese a que isAdmin() era true). Estas reglas hermanas, sin comparar el
    // wildcard, son el patrón estándar de Firestore para ese caso: no tocan el acceso de cada asesor
    // a su propia subcolección (eso lo siguen resolviendo las reglas de arriba), solo desbloquean la
    // lectura entre asesores que ya usa el admin.
    match /{path=**}/clients/{clientId} {
      allow read: if isAdmin();
    }
    match /{path=**}/leads/{leadId} {
      allow read: if isAdmin();
    }

    // Contactos importados de Excel que aún no tienen asesor asignado. Exclusivo del admin: ningún
    // asesor lee ni escribe aquí directamente — la interfaz solo la usa desde el panel de Asesores.
    match /leadsPool/{leadId} {
      allow read, write: if isAdmin();
    }

    // Lista de supresión: quien pidió no ser contactado. El id del documento es la huella SHA-256 (64 caracteres hexadecimales) del correo
    // o del teléfono normalizado y el documento no guarda ningún dato personal: solo el tipo, cuándo y quién lo registró. Así, borrar un
    // contacto o reimportar el mismo Excel no lo reactiva. Un asesor aprobado solo puede AÑADIR entradas (no leer, no modificar, no borrar);
    // el admin lee y borra. Las entradas no se modifican nunca (update: false), así que se conserva la fecha original.
    match /suppressions/{id} {
      allow read, delete: if isAdmin();
      allow create: if (isAdmin() || isAdvisor())
        && id.size() == 64
        && request.resource.data.keys().hasOnly(['kind', 'at', 'by'])
        && request.resource.data.kind in ['email', 'phone']
        && request.resource.data.at is string
        && request.resource.data.at.size() <= 40
        && request.resource.data.by == request.auth.uid;
      allow update: if false;
    }

    match /clientProfiles/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'phone', 'profession', 'locale', 'consentAt', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5
        && request.resource.data.phone.size() <= 40
        && request.resource.data.profession is string
        && request.resource.data.profession.size() >= 2
        && request.resource.data.profession.size() <= 100
        && request.resource.data.locale in ['es-DE', 'en-DE', 'de-DE']
        && request.resource.data.consentAt == request.time
        && hasNewTimestamps();
      allow update: if isAdmin() || (isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'profession', 'locale', 'consentAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5
        && request.resource.data.phone.size() <= 40
        && request.resource.data.profession is string
        && request.resource.data.profession.size() >= 2
        && request.resource.data.profession.size() <= 100
        && request.resource.data.locale in ['es-DE', 'en-DE', 'de-DE']
        && preservesCreatedAt());
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /financialAnalyses/{uid}/entries/{analysisId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'income', 'expenses', 'reserve', 'debt', 'coverage',
          'privatePension', 'investment', 'score', 'freeCash',
          'emergencyMonths', 'createdAt', 'updatedAt'
        ])
        && isMoney(request.resource.data.income)
        && isMoney(request.resource.data.expenses)
        && isMoney(request.resource.data.reserve)
        && isMoney(request.resource.data.debt)
        && request.resource.data.coverage is bool
        && request.resource.data.privatePension is bool
        && request.resource.data.investment is bool
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && request.resource.data.freeCash is number
        && request.resource.data.freeCash >= -10000000
        && request.resource.data.freeCash <= 10000000
        && request.resource.data.emergencyMonths is number
        && request.resource.data.emergencyMonths >= 0
        && request.resource.data.emergencyMonths <= 1200
        && hasNewTimestamps();
      allow update: if isOwner(uid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'income', 'expenses', 'reserve', 'debt', 'coverage',
          'privatePension', 'investment', 'score', 'freeCash',
          'emergencyMonths', 'createdAt', 'updatedAt'
        ])
        && isMoney(request.resource.data.income)
        && isMoney(request.resource.data.expenses)
        && isMoney(request.resource.data.reserve)
        && isMoney(request.resource.data.debt)
        && request.resource.data.coverage is bool
        && request.resource.data.privatePension is bool
        && request.resource.data.investment is bool
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && request.resource.data.freeCash is number
        && request.resource.data.freeCash >= -10000000
        && request.resource.data.freeCash <= 10000000
        && request.resource.data.emergencyMonths is number
        && request.resource.data.emergencyMonths >= 0
        && request.resource.data.emergencyMonths <= 1200
        && preservesCreatedAt();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /budgets/{uid}/entries/{budgetId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'income', 'entryMode', 'groups', 'directTotals', 'spent', 'freeCash', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && isMoney(request.resource.data.income)
        && request.resource.data.entryMode in ['categories', 'totals']
        && request.resource.data.groups is list
        && request.resource.data.groups.size() == 4
        && request.resource.data.directTotals is map
        && request.resource.data.directTotals.keys().hasAll(['protection', 'housing', 'savings', 'consumption'])
        && request.resource.data.directTotals.keys().hasOnly(['protection', 'housing', 'savings', 'consumption'])
        && isMoney(request.resource.data.directTotals.protection)
        && isMoney(request.resource.data.directTotals.housing)
        && isMoney(request.resource.data.directTotals.savings)
        && isMoney(request.resource.data.directTotals.consumption)
        && isMoney(request.resource.data.spent)
        && request.resource.data.freeCash is number
        && request.resource.data.freeCash >= -10000000
        && request.resource.data.freeCash <= 10000000
        && hasNewTimestamps();
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'income', 'entryMode', 'groups', 'directTotals', 'spent', 'freeCash', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && isMoney(request.resource.data.income)
        && request.resource.data.entryMode in ['categories', 'totals']
        && request.resource.data.groups is list
        && request.resource.data.groups.size() == 4
        && request.resource.data.directTotals is map
        && request.resource.data.directTotals.keys().hasAll(['protection', 'housing', 'savings', 'consumption'])
        && request.resource.data.directTotals.keys().hasOnly(['protection', 'housing', 'savings', 'consumption'])
        && isMoney(request.resource.data.directTotals.protection)
        && isMoney(request.resource.data.directTotals.housing)
        && isMoney(request.resource.data.directTotals.savings)
        && isMoney(request.resource.data.directTotals.consumption)
        && isMoney(request.resource.data.spent)
        && request.resource.data.freeCash is number
        && request.resource.data.freeCash >= -10000000
        && request.resource.data.freeCash <= 10000000
        && preservesCreatedAt();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /pensionScenarios/{uid}/entries/{scenarioId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'age', 'retirementAge', 'capital', 'monthlySavings', 'statePension', 'desiredIncome', 'growth', 'gap', 'capitalFuture', 'monthly', 'totalIncome', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.age is number
        && request.resource.data.age >= 18
        && request.resource.data.age <= 79
        && request.resource.data.retirementAge is number
        && request.resource.data.retirementAge > request.resource.data.age
        && request.resource.data.retirementAge <= 85
        && isMoney(request.resource.data.capital)
        && isMoney(request.resource.data.monthlySavings)
        && isMoney(request.resource.data.statePension)
        && isMoney(request.resource.data.desiredIncome)
        && request.resource.data.growth is number
        && request.resource.data.growth >= 0
        && request.resource.data.growth <= 12
        && isMoney(request.resource.data.gap)
        && isMoney(request.resource.data.capitalFuture)
        && isMoney(request.resource.data.monthly)
        && isMoney(request.resource.data.totalIncome)
        && hasNewTimestamps();
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'age', 'retirementAge', 'capital', 'monthlySavings', 'statePension', 'desiredIncome', 'growth', 'gap', 'capitalFuture', 'monthly', 'totalIncome', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.age is number
        && request.resource.data.age >= 18
        && request.resource.data.age <= 79
        && request.resource.data.retirementAge is number
        && request.resource.data.retirementAge > request.resource.data.age
        && request.resource.data.retirementAge <= 85
        && isMoney(request.resource.data.capital)
        && isMoney(request.resource.data.monthlySavings)
        && isMoney(request.resource.data.statePension)
        && isMoney(request.resource.data.desiredIncome)
        && request.resource.data.growth is number
        && request.resource.data.growth >= 0
        && request.resource.data.growth <= 12
        && isMoney(request.resource.data.gap)
        && isMoney(request.resource.data.capitalFuture)
        && isMoney(request.resource.data.monthly)
        && isMoney(request.resource.data.totalIncome)
        && preservesCreatedAt();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /consultationRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
          'fullName', 'email', 'phone', 'profession', 'profileUid', 'preferredContact', 'topic', 'message',
          'locale', 'consent', 'status', 'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 150
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5
        && request.resource.data.phone.size() <= 40
        && request.resource.data.profession is string
        && request.resource.data.profession.size() >= 2
        && request.resource.data.profession.size() <= 100
        && request.resource.data.profileUid is string
        && request.resource.data.profileUid.size() <= 128
        && ((!isSignedIn() && request.resource.data.profileUid == '')
          || (isSignedIn() && request.resource.data.profileUid == request.auth.uid))
        && request.resource.data.preferredContact in ['email', 'phone', 'whatsapp', 'unspecified']
        && request.resource.data.topic in ['analisis-financiero', 'proteccion', 'ahorro-inversion', 'banca', 'pension', 'vivienda', 'inversion-inmobiliaria', 'patrimonio', 'otro']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.locale in ['es-DE', 'en-DE', 'de-DE']
        && request.resource.data.consent == true
        && request.resource.data.status == 'new'
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 200
        && hasNewTimestamps();
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'adminNotes', 'assignedAdvisor', 'updatedAt'
        ])
        && request.resource.data.status in [
          'new', 'contacted', 'appointment', 'proposal', 'client', 'discarded'
        ]
        && request.resource.data.adminNotes is string
        && request.resource.data.adminNotes.size() <= 5000
        && request.resource.data.assignedAdvisor is string
        && request.resource.data.assignedAdvisor.size() <= 100
        && preservesCreatedAt();
      allow delete: if false;
    }

    match /advisorNotes/{clientId}/entries/{noteId} {
      // Advisor-to-client assignment has not been implemented yet. Until it is,
      // only the administrator may access private internal notes.
      allow read, write: if isAdmin();
    }

    match /articles/{articleId} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'titleES', 'titleEN', 'titleDE', 'slugES', 'slugEN', 'slugDE', 'excerptES', 'excerptEN', 'excerptDE',
          'bodyES', 'bodyEN', 'bodyDE', 'primaryCategory', 'tags', 'type', 'status',
          'featured', 'showAuthor', 'authorName', 'coverImageUrl',
          'coverImageAltES', 'coverImageAltEN', 'coverImageAltDE', 'seoTitleES', 'seoTitleEN', 'seoTitleDE',
          'seoDescriptionES', 'seoDescriptionEN', 'seoDescriptionDE', 'reviewedBy', 'sources',
          'updateNoteES', 'updateNoteEN', 'updateNoteDE', 'editoriallyUpdatedAt', 'createdAt', 'updatedAt', 'publishedAt'
        ])
        && request.resource.data.titleES is string
        && request.resource.data.slugES is string
        && request.resource.data.excerptES is string
        && request.resource.data.bodyES is string
        && request.resource.data.status in ['draft', 'published', 'scheduled', 'archived']
        && request.resource.data.type in ['article', 'guide', 'news', 'case-study']
        && request.resource.data.featured is bool
        && request.resource.data.showAuthor is bool
        && request.resource.data.reviewedBy is string
        && request.resource.data.reviewedBy.size() <= 120
        && request.resource.data.sources is list
        && request.resource.data.sources.size() <= 12
        && request.resource.data.updateNoteES is string
        && request.resource.data.updateNoteES.size() <= 280
        && request.resource.data.updateNoteEN is string
        && request.resource.data.updateNoteEN.size() <= 280
        && request.resource.data.updateNoteDE is string
        && request.resource.data.updateNoteDE.size() <= 280;
      allow delete: if isAdmin() && resource.data.status != 'published';
    }

    match /newsletterIssues/{issueId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'status', 'audience',
          'subjectES', 'subjectEN', 'subjectDE',
          'preheaderES', 'preheaderEN', 'preheaderDE',
          'bodyES', 'bodyEN', 'bodyDE',
          'ctaLabelES', 'ctaLabelEN', 'ctaLabelDE',
          'ctaUrl', 'internalNotes', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.status in ['draft', 'ready']
        && request.resource.data.audience == 'all'
        && request.resource.data.subjectES is string
        && request.resource.data.subjectES.size() <= 120
        && request.resource.data.subjectEN is string
        && request.resource.data.subjectEN.size() <= 120
        && request.resource.data.subjectDE is string
        && request.resource.data.subjectDE.size() <= 120
        && request.resource.data.preheaderES is string
        && request.resource.data.preheaderES.size() <= 180
        && request.resource.data.preheaderEN is string
        && request.resource.data.preheaderEN.size() <= 180
        && request.resource.data.preheaderDE is string
        && request.resource.data.preheaderDE.size() <= 180
        && request.resource.data.bodyES is string
        && request.resource.data.bodyES.size() <= 50000
        && request.resource.data.bodyEN is string
        && request.resource.data.bodyEN.size() <= 50000
        && request.resource.data.bodyDE is string
        && request.resource.data.bodyDE.size() <= 50000
        && request.resource.data.ctaLabelES is string
        && request.resource.data.ctaLabelES.size() <= 60
        && request.resource.data.ctaLabelEN is string
        && request.resource.data.ctaLabelEN.size() <= 60
        && request.resource.data.ctaLabelDE is string
        && request.resource.data.ctaLabelDE.size() <= 60
        && request.resource.data.ctaUrl is string
        && request.resource.data.ctaUrl.size() <= 500
        && request.resource.data.internalNotes is string
        && request.resource.data.internalNotes.size() <= 3000;
      allow delete: if isAdmin() && resource.data.status == 'draft';
    }

    match /newsletterSubscribers/{subscriberId} {
      // Public subscriptions will be written by the future double-opt-in backend,
      // never directly by the browser.
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
